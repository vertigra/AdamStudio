<Window x:Class="AdamStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:docking="clr-namespace:AdamStudio.Docking"
        xmlns:local="clr-namespace:AdamStudio"
        xmlns:styles="clr-namespace:AdamStudio.Styles"
        xmlns:converters="clr-namespace:AdamStudio.Converters"
        xmlns:vm="clr-namespace:AdamStudio.ViewModels"
        Title="AdamStudio"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">

    <Window.Resources>
        <!-- DataTemplates перенесены в App.xaml — здесь только StyleSelector для LayoutItem.
             AvalonDock автоматически найдёт нужный View для каждой ViewModel
             (EditorTabViewModel → EditorTabView, PropertiesToolbox → PropertiesToolView и т.д.)
             через глобальные DataTemplates в App.xaml. -->


        <!-- Конвертер для отметки галочкой текущей темы в меню «Вид → Темы» -->
        <converters:ThemeNameToBoolConverter x:Key="ThemeNameToBoolConverter" />

        <!-- StyleSelector для LayoutItem -->
        <styles:PanesStyleSelector x:Key="PanesStyleSelector">
            <styles:PanesStyleSelector.ToolboxStyle>
                <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableItem}">
                    <Setter Property="Title" Value="{Binding Model.Title}" />
                    <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                    <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}" />
                </Style>
            </styles:PanesStyleSelector.ToolboxStyle>
            
            <styles:PanesStyleSelector.DocumentStyle>
                <Style TargetType="{x:Type avalonDockControls:LayoutDocumentItem}">
                    <Setter Property="Title" Value="{Binding Model.Title}" />
                    <Setter Property="ContentId" Value="{Binding Model.ContentId}" />
                    <Setter Property="ToolTip" Value="{Binding Model.ToolTip}" />
                    <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}" />
                </Style>
            </styles:PanesStyleSelector.DocumentStyle>
        </styles:PanesStyleSelector>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Background="#F0F0F0" Padding="4">
            <MenuItem Header="_Файл">
                <MenuItem Header="Новый документ"
                          Command="{Binding OpenNewDocumentCommand}"
                          InputGestureText="Ctrl+N" />
                <MenuItem Header="Открыть файл..."
                          Command="{Binding OpenFileCommand}"
                          InputGestureText="Ctrl+O" />
                <MenuItem Header="Сохранить"
                          Command="{Binding SaveFileCommand}"
                          InputGestureText="Ctrl+S" />
                <MenuItem Header="Закрыть документ"
                          Command="{Binding CloseDocumentCommand}"
                          InputGestureText="Ctrl+W" />
                <Separator />
                <MenuItem Header="Выход" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="Панель инструментов"  Command="{Binding ToggleMainToolboxCommand}" />
                <MenuItem Header="Свойства"  Command="{Binding TogglePropertiesCommand}" />
                <MenuItem Header="Вывод" Command="{Binding ToggleOutputCommand}" />
            </MenuItem>
            <MenuItem Header="Темы" ItemsSource="{Binding AvailableThemes}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header"           Value="{Binding DisplayName}" />
                        <Setter Property="Command"          Value="{Binding DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="CommandParameter" Value="{Binding Name}" />
                        <!-- IsCheckable убран -->
                        <Style.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ThemeNameToBoolConverter}">
                                        <Binding Path="DataContext.CurrentThemeName" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Name" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="IsChecked" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </Menu>

        <!-- Классический DockingManager с DocumentsSource/AnchorablesSource (v4-стиль).
             Все события (ActiveContentChanged, DocumentClosing, DocumentClosed,
             AnchorableClosed) обрабатываются через IDockEventBinder — без code-behind. -->
        <avalonDock:DockingManager
                    x:Name="dockManager"
                    Grid.Row="1"
                    Background="#FFFFFF"
                    BorderThickness="0"
                    DocumentsSource="{Binding Documents}"
                    AnchorablesSource="{Binding Anchorables}"
                    LayoutItemContainerStyleSelector="{StaticResource PanesStyleSelector}">

            <!-- Стратегия размещения новых панелей по сторонам -->
            <avalonDock:DockingManager.LayoutUpdateStrategy>
                <docking:LayoutUpdateStrategy />
            </avalonDock:DockingManager.LayoutUpdateStrategy>

            <!-- Тема VS2013 Light -->
            <avalonDock:DockingManager.Theme>
                <themes:Vs2013LightTheme />
            </avalonDock:DockingManager.Theme>

            <!-- Стартовая структура layout:
                 - корневая вертикальная панель
                 - сверху: горизонтальная панель с документами (центр) и правой pane (260px)
                 - снизу: pane для OutputToolbox (180px)
                 LayoutUpdateStrategy найдёт эти pane по стороне и добавит в них панели. -->
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Vertical">
                    <avalonDock:LayoutPanel Orientation="Horizontal">
                        <avalonDock:LayoutDocumentPane />
                        <avalonDock:LayoutAnchorablePane DockWidth="260" />
                    </avalonDock:LayoutPanel>
                    <avalonDock:LayoutAnchorablePane DockHeight="180" />
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
    </Grid>
</Window>
