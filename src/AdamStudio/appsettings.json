{
	"App": {
		"ThemeName": "VS2013Light",
		"WindowWidth": 1100,
		"WindowHeight": 700,
		"IsMaximized": false,
		"EditorFontFamily": "Consolas",
		"EditorFontSize": 14,
		"ShowLineNumbers": true,
		"LogFilePath": "logs/app.log",
		"RetainedFileCountLimit": 14,
		"FileLogTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}",
		"OutputLogLevel": "Information",
		"GlobalLogLevel": "Debug"
	}
}