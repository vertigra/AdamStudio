<Application x:Class="AdamStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AdamStudio.ViewModels"
             xmlns:views="clr-namespace:AdamStudio.Views"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <!-- Глобальные DataTemplates: связывают ViewModel с их View.
             AvalonDock (и любой другой ItemsControl) автоматически
             применит этот шаблон, когда встретит EditorTabViewModel
             в DocumentsSource или PropertiesToolbox в AnchorablesSource. -->

        <DataTemplate DataType="{x:Type vm:EditorTabViewModel}">
            <views:EditorTabView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertiesToolboxViewModel}">
            <views:PropertiesToolView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OutputToolboxViewModel}">
            <views:OutputToolView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

    </Application.Resources>
</Application>
