<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- AvalonDock v5 — классический DockingManager (ToggleDockingManager не используется) -->
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.1" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.1" />

    <!-- Тема VS2013 (Dark/Light/Blue варианты) -->
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.1" />

    <!-- MVVM с source generators ([ObservableProperty], [RelayCommand]) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />

  </ItemGroup>
</Project>
